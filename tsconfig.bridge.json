{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.bridge.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — same rationale as tsconfig.train.json: matches tsconfig.app.json's
       resolution so relative imports into src/sim, src/env, src/agents, src/app/replay.ts,
       src/train stay extension-less. Execution goes through tsx, not `tsc`, so this file only
       affects `npm run typecheck:bridge`. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/bridge"]
}
